rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}
    // Document ID: Firebase Auth UID
    // Subcollections: users/{uid}/**
    // Fields:
    //   - username: string (optional)
    //   - email: string (optional)
    //   - updatedAt: number (optional)
    //   - nickname: string (optional)
    //   - photo: string (optional, base64)
    //   - nestCode: string (optional)
    //   - profileUpdatedAt: number (optional)
    //   - payload: string (optional, JSON backup)
    //
    // Collection: usernames/{name}
    // Document ID: lowercase username handle (3-20 chars)
    // Fields:
    //   - uid: string (required, Firebase Auth UID)
    //   - email: string (required, user email address)
    //   - username: string (required, original case handle)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Verify if caller owns the username entry by UID, or by verified account email
    // for orphan/re-registration recovery when an account is deleted and recreated.
    function canManageUsername(docData) {
      return isAuthenticated() && (
        ('uid' in docData && docData.uid == request.auth.uid) ||
        (request.auth.token.email != null &&
         'email' in docData &&
         docData.email != '' &&
         docData.email == request.auth.token.email)
      );
    }

    // Domain Validator for username mapping document
    function isValidUsernameDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'username']) &&
             data.keys().hasOnly(['uid', 'email', 'username', 'createdAt', 'updatedAt']) &&
             data.uid is string &&
             data.uid.size() > 0 &&
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.username is string &&
             data.username.size() >= 3 &&
             data.username.size() <= 30 &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // User Private Storage & Subcollections
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Username mapping & lookup
    // - Public read for handle availability check and identifier resolution
    // - Create: Authenticated user binding their own UID
    // - Update: Existing owner (by UID or verified recovery email) reclaiming/updating to current UID
    // - Delete: Existing owner (by UID or verified recovery email)
    match /usernames/{name} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    isValidUsernameDoc(request.resource.data);
      allow update: if canManageUsername(resource.data) &&
                    request.resource.data.uid == request.auth.uid &&
                    isValidUsernameDoc(request.resource.data);
      allow delete: if canManageUsername(resource.data);
    }
  }
}
